// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  profileNumber Int      @unique
  slug          String
  name          String?
  email         String   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String   @default("BUYER")
  plan          String   @default("FREE")
  companyName   String?
  country       String?
  countryCode   String?
  businessType  String?
  phone         String?
  bio           String?
  address       String?
  website       String?
  companyEmail  String?
  employeeCount String?
  socialLinks   Json?
  coverImage    String?
  logo          String?
  registrationComplete Boolean @default(false)
  galleryImages Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  products Product[]
  primaryCategory   String?
  primarySubCategory String?
  buyingRequests BuyingRequest[]
  savedProducts SavedProduct[] // ✅ اضافه شد (رابطه با SavedProduct)
  productInquiriesAsBuyer    ProductInquiry[] @relation("buyerInquiries")
  productInquiriesAsSupplier ProductInquiry[] @relation("supplierInquiries")
  sentMessages     Message[] @relation("sentMessages")
  receivedMessages Message[] @relation("receivedMessages")
  savedRequests SavedRequest[] 
  supplierQuotes Quote[] @relation("QuoteSupplier")
  buyerQuotes    Quote[] @relation("QuoteBuyer")
  savedProfiles  SavedProfile[] @relation("UserSavedProfiles")  
  savedBy        SavedProfile[] @relation("UserSavedBy") 
}

model Product {
  id             String   @id @default(cuid())
  productNumber Int      @unique
  slug          String
  name           String
  category       String
  subCategory    String?
  shortDesc      String   @db.VarChar(255)
  fullDesc       String?  @db.Text
  price          Float
  currency       String   @default("USD")
  unit           String   @default("kg")
  moq            Int
  stock          Int?
  leadTime       Int?
  images         Json
  badge          String?
  country        String?
  countryCode    String?
  origin         String?
  certifications String?
  packaging      String?
  shippingTerms  String?
  views      Int      @default(0)
  isVisible      Boolean  @default(true)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[] 
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  savedBy SavedProduct[] // ✅ اضافه شد (رابطه با SavedProduct)
  inquiries ProductInquiry[]
}

model BuyingRequest {
  id              String   @id @default(cuid())
  requestNumber Int      @unique
  slug          String
  title           String
  category        String
  views      Int      @default(0)
  subCategory     String?
  description     String
  quantity        Int
  unit            String   @default("kg")
  budgetRange     String?
  currency        String   @default("USD")
  deadline        DateTime?
  shippingTerms   String?
  deliveryCountry String
  packagingReq    String?
  certifications  String?
  attachments     Json
  isUrgent        Boolean  @default(false)
  isVisible       Boolean  @default(true)
  buyerCountry    String?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedBy SavedRequest[] 
  quotes Quote[] 
  messages Message[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ====== مدل SavedProduct (جدید) ======
model SavedProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}


model SavedProfile {
  id        String   @id @default(cuid())
  userId    String
  targetId  String
  createdAt DateTime @default(now())

  user   User @relation("UserSavedProfiles", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("UserSavedBy", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
}

// ====== مدل درخواست محصول (خریدار -> تأمین‌کننده) ======
model ProductInquiry {
  id             String   @id @default(cuid())
  productId      String
  userId         String   // خریدار (کاربری که درخواست می‌دهد)
  supplierId     String   // تأمین‌کننده (صاحب محصول)
  message        String   @db.Text
  quantity       Int?
  requestedPrice Float?
  status         String   @default("pending") // pending, responded, accepted, rejected
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade, name: "buyerInquiries")
  supplier User    @relation(fields: [supplierId], references: [id], onDelete: Cascade, name: "supplierInquiries")
  read           Boolean  @default(false) 
  @@index([productId])
  @@index([userId])
  @@index([supplierId])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  productId   String?
  requestId   String?  
  content     String   @db.Text
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sender   User   @relation(fields: [senderId], references: [id], name: "sentMessages")
  receiver User   @relation(fields: [receiverId], references: [id], name: "receivedMessages")
  product  Product? @relation(fields: [productId], references: [id])
 request  BuyingRequest? @relation(fields: [requestId], references: [id]) 

  @@index([senderId])
  @@index([receiverId])
  @@index([productId])
}
model SavedRequest {
  id        String   @id @default(cuid())
  userId    String
  requestId String
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  request BuyingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
}

model Quote {
  id           String   @id @default(cuid())
  requestId    String
  supplierId   String
  buyerId      String
  message      String   @db.Text
  quantity     Int?
  offeredPrice Float?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  request  BuyingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplier User          @relation("QuoteSupplier", fields: [supplierId], references: [id], onDelete: Cascade)
  buyer    User          @relation("QuoteBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
}